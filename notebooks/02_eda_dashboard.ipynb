{"cells":[{"cell_type":"markdown","metadata":{},"source":["# 02 — Exploratory Analysis\n","Explore workload, severity, category, MTTR, and SLA performance."]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["import pandas as pd\n","import plotly.express as px\n","df=pd.read_csv('../data/clean/incidents_clean.csv')\n","display(df.groupby('severity').agg(incidents=('incident_id','count'),avg_mttr=('mttr_hours','mean')).round(1))"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["trend=df.groupby('month').size().reset_index(name='incidents')\n","px.line(trend,x='month',y='incidents',markers=True).show()"]}],"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"nbformat_minor":5}
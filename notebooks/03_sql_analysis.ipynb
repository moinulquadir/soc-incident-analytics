{"cells":[{"cell_type":"markdown","metadata":{},"source":["# 03 — SQL Analysis\n","Practice analyst-style SQL against the cleaned incident dataset."]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["import sqlite3, pandas as pd\n","df=pd.read_csv('../data/clean/incidents_clean.csv')\n","con=sqlite3.connect(':memory:')\n","df.to_sql('incidents_clean',con,index=False,if_exists='replace')\n","pd.read_sql_query('SELECT severity, COUNT(*) AS incidents, ROUND(AVG(mttr_hours),1) AS avg_mttr FROM incidents_clean GROUP BY severity',con)"]}],"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"nbformat":4,"nbformat_minor":5}